<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.ibrahimcavdar</groupId>
    <artifactId>swing2mcp-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>swing2mcp</artifactId>
  <name>swing2mcp MCP server</name>
  <description>
    MCP server: a runnable jar without dependencies, for Java 8 and newer. Embeds the agent jar and
    injects it into the target JVM.
  </description>

  <properties>
    <swing2mcp.publish.skip>false</swing2mcp.publish.skip>
  </properties>

  <dependencies>
    <!-- Compiled against, then copied into this jar below (the connection classes and the agent jar
         it carries), so that the server stays one file without dependencies. -->
    <dependency>
      <groupId>io.github.ibrahimcavdar</groupId>
      <artifactId>swing2mcp-test</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>swing2mcp</finalName>
    <resources>
      <!-- the version the server reports comes from the build, not from the code -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>swing2mcp/version.properties</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>swing2mcp/version.properties</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>embed-client-and-agent</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>io.github.ibrahimcavdar</groupId>
                  <artifactId>swing2mcp-test</artifactId>
                  <version>${project.version}</version>
                  <!-- not the test API itself: the server does not use it -->
                  <includes>io/github/ibrahimcavdar/swing2mcp/client/**,swing2mcp/swing2mcp-agent.jar</includes>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.outputDirectory}</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>io.github.ibrahimcavdar.swing2mcp.mcp.Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
