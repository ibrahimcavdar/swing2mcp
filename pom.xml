<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.ibrahimcavdar</groupId>
  <artifactId>swing2mcp-parent</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>
  <name>swing2mcp</name>
  <description>Lets AI coding tools see and use Java Swing applications over MCP, without changing their code.</description>
  <url>https://github.com/ibrahimcavdar/swing2mcp</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Halil İbrahim Çavdar</name>
      <email>24587975+ibrahimcavdar@users.noreply.github.com</email>
      <url>https://github.com/ibrahimcavdar</url>
    </developer>
  </developers>

  <scm child.scm.connection.inherit.append.path="false"
       child.scm.developerConnection.inherit.append.path="false"
       child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/ibrahimcavdar/swing2mcp.git</connection>
    <developerConnection>scm:git:git@github.com:ibrahimcavdar/swing2mcp.git</developerConnection>
    <url>https://github.com/ibrahimcavdar/swing2mcp</url>
  </scm>

  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/ibrahimcavdar/swing2mcp/issues</url>
  </issueManagement>

  <modules>
    <module>agent</module>
    <module>demo-app</module>
    <module>demo-spring</module>
    <module>mcp</module>
    <module>maven-plugin</module>
    <module>e2e-tests</module>
  </modules>

  <properties>
    <!-- The version is set only when releasing: a tag vX.Y.Z builds with -Drevision=X.Y.Z (see
         .github/workflows/release.yml). Development builds are always 999-SNAPSHOT; never edit it. -->
    <revision>999-SNAPSHOT</revision>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Everything a user runs is built for Java 8; only e2e-tests overrides this -->
    <maven.compiler.release>8</maven.compiler.release>
    <junit.version>6.1.3</junit.version>
    <gson.version>2.15.0</gson.version>
    <!-- Publishing to Maven Central is opt-in: only agent, mcp and maven-plugin set this to false.
         Everything else (this parent, the demo applications, the tests) is never uploaded. -->
    <swing2mcp.publish.skip>true</swing2mcp.publish.skip>
    <maven.source.skip>${swing2mcp.publish.skip}</maven.source.skip>
    <maven.javadoc.skip>${swing2mcp.publish.skip}</maven.javadoc.skip>
    <gpg.skip>${swing2mcp.publish.skip}</gpg.skip>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
          <configuration>
            <compilerArgs>
              <!-- release 8 is deprecated on newer JDKs; the warning is expected -->
              <arg>-Xlint:-options</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.11.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.1</version>
        </plugin>
        <!-- The published modules declare this plugin to carry LICENSE and NOTICE in their jars -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.5.0</version>
          <executions>
            <execution>
              <id>license-files</id>
              <phase>generate-resources</phase>
              <goals>
                <goal>copy-resources</goal>
              </goals>
              <configuration>
                <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
                <resources>
                  <resource>
                    <directory>${project.basedir}/..</directory>
                    <includes>
                      <include>LICENSE</include>
                      <include>NOTICE</include>
                    </includes>
                  </resource>
                </resources>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- Installed and deployed poms stand on their own: the real version instead of ${revision},
           no parent, and the name, license, developer and scm entries Maven Central requires. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>1.9.0</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>ossrh</flattenMode>
          <pomElements>
            <build>remove</build>
          </pomElements>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- "mvn deploy" uploads to Maven Central (server id "central" in settings.xml). The upload
           is validated and then waits in the Central Portal until someone presses Publish there. -->
      <plugin>
        <groupId>org.sonatype.central</groupId>
        <artifactId>central-publishing-maven-plugin</artifactId>
        <version>0.12.0</version>
        <extensions>true</extensions>
        <configuration>
          <publishingServerId>central</publishingServerId>
          <autoPublish>false</autoPublish>
          <waitUntil>validated</waitUntil>
          <deploymentName>swing2mcp ${project.version}</deploymentName>
          <skipPublishing>${swing2mcp.publish.skip}</skipPublishing>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- What Maven Central requires next to each jar: sources, javadoc and signatures.
         Without a signing key: -Prelease -Dgpg.skip=true -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <configuration>
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
